{
    "name": "turbo/turbo-m3u8",
    "version": "2.0",
    "description": "m3u8裁剪、下载、插入，兼容php7.4到php8.4",
    "keywords": ["m3u8"],
    "license": "MIT",
    "require": {
        "php": ">=7.4 <8.5",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "authors": [
        {
            "name": "turbo",
            "email": "turbole@163.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "TurboM3u8\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\TurboM3u8\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
